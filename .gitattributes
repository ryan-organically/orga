# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force these to always have LF endings (even on Windows)
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.txt text eol=lf

# Binary files - don't touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
